# Required for the Zep parts of the lab
ZEP_API_KEY=

# Required only for the demo UI chat reply (never used for benchmark scoring).
# Get a key from Google AI Studio. GOOGLE_API_KEY also works as a fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# The lab creates/reuses this standalone graph for domain/semantic memory.
ZEP_SEMANTIC_GRAPH_ID=vinuni-lab17-domain-kb

# Docker service URLs. Keep these values when running inside docker compose.
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# The lab applies 10%/4%/3%/3% memory budgets against this context size.
LAB_CONTEXT_TOKENS=8000
